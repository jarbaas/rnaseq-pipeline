plugins {
    id 'nf-schema@2.8.0' 
}

params {
    input         = null
    outdir        = './results'
    fasta         = null
    star_index    = null
    gtf           = null
    sjdb_overhang = 149
}

docker {
    enabled = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

process {
    withName: PARABRICKS_RNAFQ2BAM {
        ext.args = "--sjdb-overhang ${params.sjdb_overhang} --read-files-command zcat"
    }
    withName: GENERATE_COUNT_MATRIX {
        container = 'amancevice/pandas:slim-3.0.5'
    }

    withLabel: 'process_single' {
        cpus   = 1
        memory = 4.GB
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = 8.GB
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 16.GB
    }
    withLabel: 'process_gpu' {
        cpus   = 16
        memory = 64.GB
        time   = '24h'
        accelerator = 1
    }
}

profiles {
    standard {
        process.executor = 'local'

        process {
            withLabel: 'process_gpu' {
                maxForks = 1
            }
        }
    }

    portable {
        process {
            errorStrategy = { task.exitStatus in [137, 143, 104, 134, 139] ? 'retry' : 'ignore' }
            maxRetries    = 3
            
            withLabel: 'process_single' {
                cpus   = { 1 * task.attempt }
                memory = { 4.GB * task.attempt }
            }
            withLabel: 'process_medium' {
                cpus   = { 4 * task.attempt }
                memory = { 8.GB * task.attempt }
            }
            withLabel: 'process_high' {
                cpus   = { 8 * task.attempt }
                memory = { 16.GB * task.attempt }
            }
            withLabel: 'process_gpu' {
                cpus   = { 16 * task.attempt }
                memory = { 64.GB * task.attempt }
            }
        }
    }
}