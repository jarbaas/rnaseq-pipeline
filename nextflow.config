plugins {
    id 'nf-schema@2.8.0' 
}

params {
    input      = null
    outdir     = './results'
    fasta      = null
    star_index = null
    gtf        = null
    sjdb_overhang = 149
}

docker {
    enabled = true
}

process {
    withName: PARABRICKS_RNAFQ2BAM {
        ext.args = "--sjdb-overhang ${params.sjdb_overhang} --read-files-command zcat"
    }
}

profiles {
    standard {
        process.executor = 'local'

        process {
            withLabel: 'process_gpu' {
                containerOptions = '--gpus all'
                maxForks = 1

            }
        }
    }

    portable {
        process {
            errorStrategy = { task.exitStatus in [137, 143, 104, 134, 139] ? 'retry' : 'finish' }
            maxRetries    = 3
            
            withLabel: 'process_single' {
                cpus   = { 1 * task.attempt }
                memory = { 4.GB * task.attempt }
            }
            withLabel: 'process_medium' {
                cpus   = { 4 * task.attempt }
                memory = { 8.GB * task.attempt }
            }
            withLabel: 'process_high' {
                cpus   = { 8 * task.attempt }
                memory = { 16.GB * task.attempt }
            }
            withLabel: 'process_gpu' {
                cpus   = { 16 * task.attempt }
                memory = { 64.GB * task.attempt }
                time   = '24h'
                containerOptions = '--gpus all'
            }
        }
    }
}