{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": { 
                "type": "string", 
                "pattern": "^[a-zA-Z0-9_\\-]+$",
                "minLength": 1,
                "meta": ["sample"]
            },
            "timepoint": { 
                "type": "integer", 
                "minimum": 0,
                "meta": ["timepoint"]
            },
            "treatment": { 
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_\\-]+$",
                "meta": ["treatment"]
            },
            "replicate": { 
                "type": "integer", 
                "minimum": 1,
                "meta": ["replicate"] 
            },
            "strandedness": {
                "type": "string",
                "enum": ["unstranded", "forward", "reverse"],
                "meta": ["strandedness"]
            },
            "fastq_1": { 
                "type": "string", 
                "format": "file-path",
                "pattern": "^[A-Za-z0-9_./-]+\\.(fastq|fq)(\\.gz)?$"
            },
            "fastq_2": { 
                "type": "string", 
                "format": "file-path",
                "pattern": "^[A-Za-z0-9_./-]+\\.(fastq|fq)(\\.gz)?$"
            }
        },
        "required": ["sample", "timepoint", "treatment", "replicate", "strandedness", "fastq_1", "fastq_2"],
        "additionalProperties": false
    }
}